{
  "name": "helpdesk-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/predeploy.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create helpdesk-db",
    "db:migrate:local": "wrangler d1 migrations apply helpdesk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply helpdesk-db --remote",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && node --check public/app.js && node --check public/notifications.js && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20260722.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0",
      "sharp": "0.35.4"
    }
  }
}
