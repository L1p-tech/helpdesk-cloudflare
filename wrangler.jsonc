{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpdesk-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helpdesk-db",
      "database_id": "3b3a1076-5fd6-4a87-9be5-50c7ccf544ac",
      "migrations_dir": "migrations"
    }
  ],
  // Holt die Nachrichtenquellen alle 30 Minuten, auch wenn niemand die Seite
  // benutzt. Ohne diesen Ausloeser liefe der Abruf nur beim Seitenaufruf mit.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "SESSION_TTL_HOURS": "12"
  }
}
